#!/bin/bash
#ultimate job
#SBATCH --job-name=STVO_train
#SBATCH --output=out/ultimate-STVO-train-JOB-%j.out
#SBATCH --error=err/ultimate-STVO-train-JOB-%j.err
#SBATCH --nodes=1 # As we have single node it should be always set as 1
#SBATCH --cpus-per-task=40 # Number of CPUs # max = 80
#SBATCH --gres=gpu:7g.79gb:1  # Allocate 1 GPU resources with specified configurations
#SBATCH --mem=300G  # Specify the total amount of memory # max = 300G
#SBATCH --time=96:00:00  # Set the time limit to 1 minute
#SBATCH --partition=ultimate
#SBATCH --qos=ultimate
#SBATCH --account=ultimate

 


# Save echo device info into CSV file
mkdir -p ./MIG-IDs
echo $SLURM_JOB_ID, $CUDA_VISIBLE_DEVICES > ./MIG-IDs/ultimate-monitor-JOBID-$SLURM_JOB_ID.csv
nvidia-smi -L >> ./MIG-IDs/ultimate-monitor-JOBID-$SLURM_JOB_ID.csv
nvidia-smi >> ./MIG-IDs/ultimate-monitor-JOBID-$SLURM_JOB_ID.csv


# Paths and parameters
ROOT_DIR="/fast_storage/siddig"
DATA_DIR="$ROOT_DIR/driving-license"

HUGG_OUT_DIR="/fast_storage/siddig/driving-license/STVo_PRLM_HF_hierarchical_models_test_20_epochs_10_segments"
OUT_DIR="/fast_storage/siddig/driving-license/STVo_PRLM_PY_hierarchical_models_test_20_epochs_10_segments"

mkdir -p $DATA_DIR
mkdir -p $HUGG_OUT_DIR
mkdir -p $OUT_DIR

HF_DIR="$ROOT_DIR/driving-license/HF_models"

# Set Hugging Face cache directories
export HF_HOME=$HF_DIR
export TRANSFORMERS_CACHE=$HF_DIR
export HF_DATASETS_CACHE=$HF_DIR
# Matplotlib
export MPLCONFIGDIR="/fast_storage/siddig/driving-license/.matplotlib"
# Wandb
export WANDB_DIR="/fast_storage/siddig/driving-license/wandb_logs"
export WANDB_CACHE_DIR="/fast_storage/siddig/driving-license/wandb_cache"
export WANDB_DATA_DIR="/fast_storage/siddig/driving-license/wandb_data"



# Create and activate the virtual environment if it doesn't already exist
if [ ! -d "$DATA_DIR/driving-env" ]; then
    python3 -m venv $DATA_DIR/driving-env
    source $DATA_DIR/driving-env/bin/activate
    bash ./install.sh
fi 

source $DATA_DIR/driving-env/bin/activate
# bash ./install.sh
     

MASKED_MODELS=(
    nlpaueb/legal-bert-base-uncased
    nlpaueb/legal-bert-small-uncased
    casehold/custom-legalbert
    google-bert/bert-base-uncased
    # microsoft/deberta-base exceeding memory
    avichr/Legal-heBERT
    dlicari/Italian-Legal-BERT   
) 

CAUSAL_MODELS=(
    Qwen/Qwen3-Embedding-0.6B
    google/gemma-3-270m
    google/gemma-3-270m-it
    openai-community/gpt2
)


###################### STvO with m2m100_418M translation ##########################

# rotate
# add rotate to outdir
out_DIR_ROTATE="${OUT_DIR}_rotate"
HUGG_OUT_DIR_ROTATE="${HUGG_OUT_DIR}_rotate"
for BASE_MODEL in "${MASKED_MODELS[@]}"; do
        python ../finetune_multi_task_STvO_mlm_clm_clu.py \
            --translator_model_name "m2m100_418M" \
            --clm_data_path ../data/stvo/m2m100_418M_translated_integrated_Straßenverkehrs_Ordnung_graph.dot \
            --nsp_data_path ../data/stvo/m2m100_418M_translated_main_content_Straßenverkehrs_Ordnung_graph_nsp_dataset.json \
            --clu_data_path ../data/stvo/m2m100_418M_translated_main_content_Straßenverkehrs_Ordnung_graph_sentence_clu_dataset.json \
            --cls_data_path /data/aimotion/siddig/legal-data/qa.jsonl \
            --paragraph_embeddings_file ../legal-KGE/embeddings/rotate/m2m100_418M_STvO/rotate_paragraph_embeddings_best.json \
            --train_history_path "training_history_job$SLURM_JOB_ID.json" \
            --plot_path "training_progress_job$SLURM_JOB_ID.png" \
            --wandb_project "rotate-LLM-Drive-License-structured-Understanding" \
            --base_model_name $BASE_MODEL \
            --modeling_type 'masked' \
            --hf_cache_dir $HF_DIR \
            --output_dir $out_DIR_ROTATE \
            --hugg_out_dir $HUGG_OUT_DIR_ROTATE \
            --num_epochs 20\
            --batch_size_clu 16\
            --batch_size_nsp 16\
            --batch_size_cls 16\
            --learning_rate 5e-5\
            --clm_mlm_lambdas 1.0\
            --cls_lambdas 0.0\
            --gradient_accumulation_steps 1\
            --clm_block_size 512\
            --max_seq_length_clu 128\
            --max_seq_length_nsp 128 \
            --max_seq_length_cls 128 \
            --max_segments 10\
            --seed 42

done

# distmult
out_DIR_DISTMULT="${OUT_DIR}_distmult"
HUGG_OUT_DIR_DISTMULT="${HUGG_OUT_DIR}_distmult"
for BASE_MODEL in "${MASKED_MODELS[@]}"; do
        python ../finetune_multi_task_STvO_mlm_clm_clu.py \
            --translator_model_name "m2m100_418M" \
            --clm_data_path ../data/stvo/m2m100_418M_translated_integrated_Straßenverkehrs_Ordnung_graph.dot \
            --nsp_data_path ../data/stvo/m2m100_418M_translated_main_content_Straßenverkehrs_Ordnung_graph_nsp_dataset.json \
            --clu_data_path ../data/stvo/m2m100_418M_translated_main_content_Straßenverkehrs_Ordnung_graph_sentence_clu_dataset.json \
            --cls_data_path /data/aimotion/siddig/legal-data/qa.jsonl \
            --paragraph_embeddings_file ../legal-KGE/embeddings/distmult/m2m100_418M_STvO/distmult_paragraph_embeddings_best.json \
            --train_history_path "training_history_job$SLURM_JOB_ID.json" \
            --plot_path "training_progress_job$SLURM_JOB_ID.png" \
            --wandb_project "distmult-LLM-Drive-License-structured-Understanding" \
            --base_model_name $BASE_MODEL \
            --modeling_type 'masked' \
            --hf_cache_dir $HF_DIR \
            --output_dir $out_DIR_DISTMULT \
            --hugg_out_dir $HUGG_OUT_DIR_DISTMULT \
            --num_epochs 20\
            --batch_size_clu 16\
            --batch_size_nsp 16\
            --batch_size_cls 16\
            --learning_rate 5e-5\
            --clm_mlm_lambdas 1.0\
            --cls_lambdas 0.0\
            --gradient_accumulation_steps 1\
            --clm_block_size 512\
            --max_seq_length_clu 128\
            --max_seq_length_nsp 128 \
            --max_seq_length_cls 128 \
            --max_segments 10\
            --seed 42
done

# complex
out_DIR_COMPLEX="${OUT_DIR}_complex"
HUGG_OUT_DIR_COMPLEX="${HUGG_OUT_DIR}_complex"
for BASE_MODEL in "${MASKED_MODELS[@]}"; do
        python ../finetune_multi_task_STvO_mlm_clm_clu.py \
            --translator_model_name "m2m100_418M" \
            --clm_data_path ../data/stvo/m2m100_418M_translated_integrated_Straßenverkehrs_Ordnung_graph.dot \
            --nsp_data_path ../data/stvo/m2m100_418M_translated_main_content_Straßenverkehrs_Ordnung_graph_nsp_dataset.json \
            --clu_data_path ../data/stvo/m2m100_418M_translated_main_content_Straßenverkehrs_Ordnung_graph_sentence_clu_dataset.json \
            --cls_data_path /data/aimotion/siddig/legal-data/qa.jsonl \
            --paragraph_embeddings_file ../legal-KGE/embeddings/complex/m2m100_418M_STvO/complex_paragraph_embeddings_best.json \
            --train_history_path "training_history_job$SLURM_JOB_ID.json" \
            --plot_path "training_progress_job$SLURM_JOB_ID.png" \
            --wandb_project "complex-LLM-Drive-License-structured-Understanding" \
            --base_model_name $BASE_MODEL \
            --modeling_type 'masked' \
            --hf_cache_dir $HF_DIR \
            --output_dir $out_DIR_COMPLEX \
            --hugg_out_dir $HUGG_OUT_DIR_COMPLEX \
            --num_epochs 20\
            --batch_size_clu 16\
            --batch_size_nsp 16\
            --batch_size_cls 16\
            --learning_rate 5e-5\
            --clm_mlm_lambdas 1.0\
            --cls_lambdas 0.0\
            --gradient_accumulation_steps 1\
            --clm_block_size 512\
            --max_seq_length_clu 128\
            --max_seq_length_nsp 128 \
            --max_seq_length_cls 128 \
            --max_segments 10\
            --seed 42
done

# transe
out_DIR_TRanse="${OUT_DIR}_transe"
HUGG_OUT_DIR_TRanse="${HUGG_OUT_DIR}_transe"
for BASE_MODEL in "${MASKED_MODELS[@]}"; do
        python ../finetune_multi_task_STvO_mlm_clm_clu.py \
            --translator_model_name "m2m100_418M" \
            --clm_data_path ../data/stvo/m2m100_418M_translated_integrated_Straßenverkehrs_Ordnung_graph.dot \
            --nsp_data_path ../data/stvo/m2m100_418M_translated_main_content_Straßenverkehrs_Ordnung_graph_nsp_dataset.json \
            --clu_data_path ../data/stvo/m2m100_418M_translated_main_content_Straßenverkehrs_Ordnung_graph_sentence_clu_dataset.json \
            --cls_data_path /data/aimotion/siddig/legal-data/qa.jsonl \
            --paragraph_embeddings_file ../legal-KGE/embeddings/transe/m2m100_418M_STvO/paragraph_embeddings_best.json \
            --train_history_path "training_history_job$SLURM_JOB_ID.json" \
            --plot_path "training_progress_job$SLURM_JOB_ID.png" \
            --wandb_project "transe-LLM-Drive-License-structured-Understanding" \
            --base_model_name $BASE_MODEL \
            --modeling_type 'masked' \
            --hf_cache_dir $HF_DIR \
            --output_dir $out_DIR_TRanse \
            --hugg_out_dir $HUGG_OUT_DIR_TRanse \
            --num_epochs 20\
            --batch_size_clu 16\
            --batch_size_nsp 16\
            --batch_size_cls 16\
            --learning_rate 5e-5\
            --clm_mlm_lambdas 1.0\
            --cls_lambdas 0.0\
            --gradient_accumulation_steps 1\
            --clm_block_size 512\
            --max_seq_length_clu 128\
            --max_seq_length_nsp 128 \
            --max_seq_length_cls 128 \
            --max_segments 10\
            --seed 42


