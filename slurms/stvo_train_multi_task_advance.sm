#!/bin/bash
#advance job
#SBATCH --job-name=STVO_train
#SBATCH --output=out/advance-STVO-train-JOB-%j.out
#SBATCH --error=err/advance-STVO-train-JOB-%j.err
#SBATCH --nodes=1 # As we have single node it should be always set as 1
#SBATCH --cpus-per-task=40 # Number of CPUs # max = 40
#SBATCH --gres=gpu:nvidia_a100_80gb_pcie_3g.39gb:1  # Allocate 1 GPU resources with specified configurations
#SBATCH --mem=100G  # Specify the total amount of memory # max = 300G
#SBATCH --time=120:00:00  # Set the time limit to 1 minute
#SBATCH --partition=advance
#SBATCH --qos=advance
#SBATCH --account=advance


 

# Save echo device info into CSV file
mkdir -p ./MIG-IDs
echo $SLURM_JOB_ID, $CUDA_VISIBLE_DEVICES > ./MIG-IDs/advance-monitor-JOBID-$SLURM_JOB_ID.csv
nvidia-smi -L >> ./MIG-IDs/advance-monitor-JOBID-$SLURM_JOB_ID.csv
nvidia-smi >> ./MIG-IDs/advance-monitor-JOBID-$SLURM_JOB_ID.csv



# Paths and parameters
ROOT_DIR="/fast_storage/siddig"
DATA_DIR="$ROOT_DIR/driving-license"


HUGG_OUT_DIR="/super_fast_storage/siddig/driving-license/STVo_PRLM_HF_hierarchical_models"
OUT_DIR="/super_fast_storage/siddig/driving-license/STVo_PRLM_PY_hierarchical_models"

HF_DIR="$ROOT_DIR/driving-license/HF_models"

mkdir -p $DATA_DIR
mkdir -p $HUGG_OUT_DIR
mkdir -p $OUT_DIR

# Create and activate the virtual environment if it doesn't already exist
if [ ! -d "$DATA_DIR/driving-env" ]; then
    python3 -m venv $DATA_DIR/driving-env
    source $DATA_DIR/driving-env/bin/activate
    bash ./install.sh
fi 

source $DATA_DIR/driving-env/bin/activate
