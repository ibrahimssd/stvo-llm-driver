        #     --base_model_name $BASE_MODEL \
        #     --modeling_type 'causal' \
        #     --hf_cache_dir $HF_DIR \
        #     --output_dir $OUT_DIR \
        #     --hugg_out_dir $HUGG_OUT_DIR \
