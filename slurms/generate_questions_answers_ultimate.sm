# MISTRAL 7B INSTRUCT V0.2
# GERMAN
python ../generate_citation_qa_data.py \
    --model_name "mistralai/Mistral-7B-Instruct-v0.2" \
    --num_samples 5000 \
    --hf_token "$HF_TOKEN" \
    --input_file "../data/stvo/parsed_main_content_Straßenverkehrs_Ordnung_de.json" \
    --output_file "../data/synthetic-data/stvo/citations/citation_qa_stvo_mistral_german.jsonl" \
    --language "de" \
    --shuffle_sentences



