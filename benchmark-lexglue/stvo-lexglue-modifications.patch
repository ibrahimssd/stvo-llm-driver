+# =============================================================================
+# EVALUATION FUNCTION
+# =============================================================================
+evaluate_model() {
+    local MODEL_PATH=$1
+    local MODEL_CATEGORY=$2
+    local SEED=$3
+    
+    # Extract model name for logging
+    MODEL_NAME=$(basename "$MODEL_PATH")
+    
+    echo "=================================================="
+    echo "Evaluating: $MODEL_NAME"
+    echo "Path: $MODEL_PATH"
+    echo "Category: $MODEL_CATEGORY"
+    echo "Seed: $SEED"
+    echo "=================================================="
+    
+  
+    # Output directory
+    OUTPUT_DIR="$DATA_DIR/logs/${TASK}/${MODEL_CATEGORY}/${MODEL_NAME}/seed_${SEED}"
+    mkdir -p "$OUTPUT_DIR"
+
+    # Run evaluation
+    CUDA_VISIBLE_DEVICES=${GPU_NUMBER} python ../experiments/ecthr.py \
+        --model_name_or_path "${MODEL_PATH}" \
+        --do_lower_case ${LOWER_CASE} \
+        --output_dir "${OUTPUT_DIR}" \
+        --do_train \
+        --do_eval \
+        --do_pred \
+        --load_best_model_at_end \
+        --metric_for_best_model micro-f1 \
+        --greater_is_better True \
+        --eval_strategy epoch \
+        --save_strategy epoch \
+        --dataloader_num_workers 2 \
+        --save_total_limit 2 \
+        --num_train_epochs 20\
+        --learning_rate 3e-5 \
+        --dataloader_pin_memory True\
+        --cache_dir $HF_DIR\
+        --task ${TASK} \
+        --per_device_train_batch_size ${TRAIN_BATCH_SIZE} \
+        --per_device_eval_batch_size ${EVAL_BATCH_SIZE} \
+        --seed ${SEED} \
+        --fp16 \
+        --fp16_full_eval \
+        --gradient_accumulation_steps ${ACCUMULATION_STEPS} \
+        --eval_accumulation_steps ${ACCUMULATION_STEPS} >> "$LOG_OUT" 2>> "$LOG_ERR"
+
+
+    
+    # Check if evaluation was successful
+    if [ $? -eq 0 ]; then
+        echo "✓ Completed: $MODEL_NAME (seed $SEED)"
+        
+        # Display results if available
+        if [ -f "${OUTPUT_DIR}/eval_results.json" ]; then
+            echo "Results preview:"
+            cat "${OUTPUT_DIR}/eval_results.json"
+        fi
+    else
+        echo "✗ FAILED: $MODEL_NAME (seed $SEED)"
+    fi
+    echo ""
