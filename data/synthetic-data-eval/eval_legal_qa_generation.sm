#!/bin/bash
#ultimate job
#SBATCH --job-name=eval-legal-qa-generation
#SBATCH --output=out/ultimate-eval-JOB-%j.out
#SBATCH --error=err/ultimate-eval-JOB-%j.err
#SBATCH --nodes=1 # As we have single node it should be always set as 1
#SBATCH --cpus-per-task=10 # Number of CPUs # max = 80
#SBATCH --gres=gpu:7g.79gb:1  # Allocate 1 GPU resources with specified configurations
#SBATCH --mem=100G  # Specify the total amount of memory # max = 300G
#SBATCH --time=40:00:00  # Set the time limit to maximum 96 hours
#SBATCH --partition=ultimate
#SBATCH --qos=ultimate
#SBATCH --account=ultimate



ROOT_DIR_SUPER_FAST="/super_fast_storage/siddig"
# Paths and parameters
ROOT_DIR_FAST="/fast_storage/siddig"
DATA_DIR="$ROOT_DIR_FAST/driving-license"
HF_DIR="$ROOT_DIR_FAST/driving-license/HF_models"




mkdir -p $DATA_DIR
mkdir -p $HF_DIR


# Create and activate the virtual environment if it doesn't already exist
if [ ! -d "$DATA_DIR/driving-env" ]; then
    python3 -m venv $DATA_DIR/driving-env
    source $DATA_DIR/driving-env/bin/activate
    bash ./install.sh
fi 

source $DATA_DIR/driving-env/bin/activate
# bash ./install.sh


MASKED_MODELS=(
    dlicari/Italian-Legal-BERT
    avichr/Legal-heBERT
    nlpaueb/legal-bert-base-uncased
    nlpaueb/legal-bert-small-uncased
    casehold/custom-legalbert
    google-bert/bert-base-uncased
    microsoft/deberta-base unusable 
)


for model_name in "${MASKED_MODELS[@]}"; do
    
    echo "Evaluating model: $model_name"
    python ../eval_legal_qa_generation.py \
        --model_name "$model_name" \
        --real_qa_path "../data/test-sets/austrian-driving-license/fragen" \
        --generated_file "../data/synthetic-data/stvo/qa_llama_highquality.jsonl" \
        --save_path "../data/synthetic-data/stvo/quality-stats/similarity_scores_$(echo $model_name | tr '/' '_').json" \
        --plot_path "../data/synthetic-data/stvo/quality-stats/similarity_scores_boxplot_$(echo $model_name | tr '/' '_').png" \
        --language "en" \

    echo "Finished evaluating model: $model_name"
done
    


